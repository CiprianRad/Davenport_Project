/-!
# The native checks of Lemma 5.3

The finite input of Lemma 5.3 is evaluated by `native_decide`, in thirteen statements over the
precompiled library `DavenportCompute`: `top` here, and the chunks in `Bases/CubeFour/Checks/`
(separate modules, so that they run in parallel). `chunks14` and `chunks18` assemble them. These
are the only facts of the formalization that rely on compiled code; they add one axiom each,
generated by `native_decide`.
-/

/-!
## Native check: the enumeration prefixes of depth four

Every prefix of depth four reached by `gdfs` is listed in `prefixes 4`. Together with the
chunk checks this covers the whole enumeration.
Evaluated by `native_decide`: compiled code from the precompiled library
`DavenportCompute`, so the theorem depends on the axiom generated by `native_decide` in addition
to `propext`, `Classical.choice` and `Quot.sound`.
-/

public section

namespace DavenportProject.CubeFour.Checks

open DavenportCompute

/-- Every prefix of depth four reached by the enumeration is in `prefixes 4`. -/
theorem top : gdfs (fun acc => (prefixes 4).contains acc) 4 1 [] 0 0 0 = true := by
  native_decide

end DavenportProject.CubeFour.Checks

end

/-!
## The native checks of Lemma 5.3, assembled

Every prefix of depth four lies in one of the six chunks (`chunk 6 (mix p % 6)`), so the twelve
chunk checks give the enumeration below every prefix in `prefixes 4`, for both leaf tests.
-/

public section

namespace DavenportProject.CubeFour.Checks

open DavenportCompute

theorem mem_chunk_mix {P : List (List Nat)} {p : List Nat} (hp : p ∈ P) :
    p ∈ chunk 6 (mix p % 6) P :=
  List.mem_filter.2 ⟨hp, by simp⟩

/-- The enumeration for Lemma 5.3(1) passes below every prefix of depth four. -/
theorem chunks14 : ∀ p ∈ prefixes 4, gdfsFrom leaf14 10 p = true := by
  intro p hp
  have hmem := mem_chunk_mix hp
  have hi : mix p % 6 < 6 := Nat.mod_lt _ (by decide)
  generalize mix p % 6 = i at hi hmem
  match i, hi, hmem with
  | 0, _, h => exact List.all_eq_true.1 chunk14_0 p h
  | 1, _, h => exact List.all_eq_true.1 chunk14_1 p h
  | 2, _, h => exact List.all_eq_true.1 chunk14_2 p h
  | 3, _, h => exact List.all_eq_true.1 chunk14_3 p h
  | 4, _, h => exact List.all_eq_true.1 chunk14_4 p h
  | 5, _, h => exact List.all_eq_true.1 chunk14_5 p h
  | n + 6, hi, _ => exact absurd hi (by omega)

/-- The enumeration for Lemma 5.3(2) passes below every prefix of depth four. -/
theorem chunks18 : ∀ p ∈ prefixes 4, gdfsFrom leaf18 14 p = true := by
  intro p hp
  have hmem := mem_chunk_mix hp
  have hi : mix p % 6 < 6 := Nat.mod_lt _ (by decide)
  generalize mix p % 6 = i at hi hmem
  match i, hi, hmem with
  | 0, _, h => exact List.all_eq_true.1 chunk18_0 p h
  | 1, _, h => exact List.all_eq_true.1 chunk18_1 p h
  | 2, _, h => exact List.all_eq_true.1 chunk18_2 p h
  | 3, _, h => exact List.all_eq_true.1 chunk18_3 p h
  | 4, _, h => exact List.all_eq_true.1 chunk18_4 p h
  | 5, _, h => exact List.all_eq_true.1 chunk18_5 p h
  | n + 6, hi, _ => exact absurd hi (by omega)

end DavenportProject.CubeFour.Checks

end
