module

/-!
# The enumeration of Lemma 5.3, written for evaluation by the kernel

The finite part of Lemma 5.3 is checked by `decide +kernel`, so the functions of this file are
written for Lean's kernel rather than for compiled code:

* only the arithmetic operations that the kernel performs on numerals directly (`Nat.add`,
  `Nat.mul`, `Nat.land`, `Nat.shiftLeft`, …) are used, called by name, with no type classes;
* `force n k` hands `k` the value of `n` rather than the expression `n`;
* recursion is written with `Nat.rec`.

Codes, sets and sums are those of `DavenportCompute.Basic`: the element `(x₀, x₁, x₂)` of
`(ZMod 4)^3` has the code `x₀ + 4 x₁ + 16 x₂ < 64`, and a set of codes is a bit mask.

* `State`: what the enumeration remembers about a sorted list of codes (its prefix so far).
* `step st x`: the state after appending the code `x`.
* `cands st`: the codes that may be appended. They are at least the last code, are not the
  negative of a sum of at most three entries (no zero set of size at most four), respect the
  guards, and keep the multiplicity normalization.
* `dfs mid leaf k n st d`: visits every extension of the prefix by at most `n` allowed codes,
  threading the data `d`: `leaf` at the extensions by `n` codes, `mid` at those by `n - k - 1`.
* `leaf N t st d`: the test at a sequence of length `N`. Either the code sum is a sum of at most
  three entries, so that the complement of those entries is a long zero set, or `d` starts with a
  certificate of an integral `𝓘_t`-identity, which is checked (`checkEntries`).
* `topDfs`, `chunkRun`: the enumeration split into the part down to the chunk roots and the
  subtrees below them (the modules `DavenportCompute.Checks`).

Nothing in the data is trusted: a wrong certificate makes the check fail. The meaning of these
functions is proved in `DavenportProject.Bases.CubeFour.SearchBits`, `SearchSound` and
`SearchCert`.
-/

@[expose] public section

namespace DavenportCompute.Search

universe u

/-- `force n k = k n`, but the kernel computes the numeral `n` before it continues. -/
def force {α : Sort u} (n : Nat) (k : Nat → α) : α :=
  Nat.rec (motive := fun _ => α) (k 0) (fun m _ => k (Nat.succ m)) n

/-! ## Constants -/

/-- `2 ^ 64 - 1`. -/
def FULL : Nat := 18446744073709551615
/-- `2 ^ 128 - 1`. -/
def FULL2 : Nat := 340282366920938463463374607431768211455
/-- The lowest bit of every block of four bits, in 128 bits. -/
def REP0 : Nat := 22685491128062564230891640495451214097
/-- The lowest bit of every block of sixteen bits, in 128 bits. -/
def REP1 : Nat := 5192376087906286159508272029171713
/-- The lowest bit of each 64-bit half. -/
def REP2 : Nat := 18446744073709551617
/-- The codes `-x`, six bits per code `x`. -/
def NEGTAB : Nat := 13143920110496856632103759678910453717808174777432766955908518443933326786677949205764028708183408120446393117843648
/-- A de Bruijn sequence for 64-bit words. -/
def DB : Nat := 285870213051386505
/-- The bit indices for `DB`, six bits each. -/
def DBTAB : Nat := 3762508819988097413073072872543584677525223375037184394338996487988414181932085329055353629958208714152624052174912
/-- The codes excluded while `1` is absent: `P1` codes other than `1`. -/
def G1 : Nat := 18446738554676574968
/-- The codes excluded while `4` is absent: `P2` codes other than `4`. -/
def G4 : Nat := 18446727516610621664
/-- The codes excluded while `16` is absent: `P3` codes other than `16`. -/
def G16 : Nat := 18446462603027677184
/-- The set of codes with `P1`. -/
def MP1 : Nat := 18446738554676574970
/-- The set of codes with `P2`. -/
def MP2 : Nat := 18446727516610621680
/-- The set of codes with `P3`. -/
def MP3 : Nat := 18446462603027742720

/-! ## Codes and sets of codes -/

/-- Bit `x` of `S`. -/
def bitB (S x : Nat) : Bool := Nat.beq (Nat.land (Nat.shiftRight S x) 1) 1

/-- The code of `-x`. -/
def negc (x : Nat) : Nat := Nat.land (Nat.shiftRight NEGTAB (Nat.mul x 6)) 63

/-- The code of `a + b`: the three base-4 digits are added without carries between them. -/
def addc (a b : Nat) : Nat :=
  Nat.xor (Nat.add (Nat.land a 21) (Nat.land b 21)) (Nat.land (Nat.xor a b) 42)

/-- Rotate, in both 64-bit halves of `S`, the base-4 digit of stride `2 ^ sh` of every code by
`t < 4`; `rep` has the lowest bit of every block of `4 * 2 ^ sh` bits. -/
def rot (S rep sh t : Nat) : Nat :=
  Nat.lor
    (Nat.shiftLeft
      (Nat.land S (Nat.mul rep (Nat.sub (Nat.shiftLeft 1 (Nat.shiftLeft (Nat.sub 4 t) sh)) 1)))
      (Nat.shiftLeft t sh))
    (Nat.shiftRight
      (Nat.land S
        (Nat.xor FULL2 (Nat.mul rep (Nat.sub (Nat.shiftLeft 1 (Nat.shiftLeft (Nat.sub 4 t) sh)) 1))))
      (Nat.shiftLeft (Nat.sub 4 t) sh))

/-- Translate both 64-bit halves of `S`, as sets of codes, by the code `y`. -/
def transl2 (S y : Nat) : Nat :=
  rot (rot (rot S REP0 0 (Nat.land y 3)) REP1 2 (Nat.land (Nat.shiftRight y 2) 3)) REP2 4
    (Nat.shiftRight y 4)

/-- A guess for the lowest set bit of `cand` (it is only used as a guess, see `loop`). -/
def lowIdx (cand : Nat) : Nat :=
  Nat.land (Nat.shiftRight DBTAB (Nat.mul (Nat.shiftRight
    (Nat.land (Nat.mul (Nat.land cand (Nat.xor cand (Nat.sub cand 1))) DB) FULL) 58) 6)) 63

/-! ## The state of the enumeration -/

/-- What the enumeration remembers about a sorted prefix of codes. -/
structure State where
  /-- the last code (`1` for the empty prefix) -/
  lo : Nat
  /-- the negatives of the entries (low 64 bits) and of the sums of two entries (high 64 bits) -/
  P : Nat
  /-- the negatives of the sums of one, two or three entries -/
  F : Nat
  /-- the codes excluded by the guards -/
  G : Nat
  /-- the number of entries `1` -/
  c1 : Nat
  /-- the number of entries `4` -/
  c4 : Nat
  /-- the number of entries `16` -/
  c16 : Nat
  /-- the number of entries equal to `lo` -/
  run : Nat
  /-- the code sum -/
  s : Nat
  /-- the entries, six bits each, the last one lowest -/
  q : Nat

/-- The codes excluded by the guards, given the numbers of entries `1`, `4` and `16`. -/
def gmask (c1 c4 c16 : Nat) : Nat :=
  Nat.lor (cond (Nat.beq c1 0) G1 0) (Nat.lor (cond (Nat.beq c4 0) G4 0) (cond (Nat.beq c16 0) G16 0))

/-- The state of the empty prefix. -/
def root : State := ⟨1, 0, 0, gmask 0 0 0, 0, 0, 0, 0, 0, 0⟩

/-- The state after appending the code `x`. Only the bit sets are computed at once; the other
fields are computed when they are needed. -/
def step (st : State) (x : Nat) : State :=
  force (transl2 st.P (negc x)) fun T =>
  force (Nat.lor st.P (Nat.lor (Nat.shiftLeft 1 (negc x)) (Nat.shiftLeft (Nat.land T FULL) 64))) fun P =>
  force (Nat.lor st.F (Nat.lor (Nat.shiftLeft 1 (negc x)) (Nat.land (Nat.lor T (Nat.shiftRight T 64)) FULL)))
    fun F =>
  cond (Nat.ble x 16)
    ⟨x, P, F, gmask (cond (Nat.beq x 1) (Nat.succ st.c1) st.c1) (cond (Nat.beq x 4) (Nat.succ st.c4) st.c4)
        (cond (Nat.beq x 16) (Nat.succ st.c16) st.c16),
      cond (Nat.beq x 1) (Nat.succ st.c1) st.c1, cond (Nat.beq x 4) (Nat.succ st.c4) st.c4,
      cond (Nat.beq x 16) (Nat.succ st.c16) st.c16, cond (Nat.beq x st.lo) (Nat.succ st.run) 1,
      addc st.s x, Nat.lor (Nat.shiftLeft st.q 6) x⟩
    ⟨x, P, F, st.G, st.c1, st.c4, st.c16, cond (Nat.beq x st.lo) (Nat.succ st.run) 1,
      addc st.s x, Nat.lor (Nat.shiftLeft st.q 6) x⟩

/-- Appending one more copy of the last code keeps the multiplicity normalization: no code with
`P1` (other than `1`) occurs more often than `1`, and likewise for `P2` and `4`, `P3` and `16`. -/
def okRep (st : State) : Bool :=
  (!(bitB MP1 st.lo) || Nat.beq st.lo 1 || Nat.ble (Nat.succ st.run) st.c1) &&
  (!(bitB MP2 st.lo) || Nat.beq st.lo 4 || Nat.ble (Nat.succ st.run) st.c4) &&
  (!(bitB MP3 st.lo) || Nat.beq st.lo 16 || Nat.ble (Nat.succ st.run) st.c16)

/-- The codes that may be appended (see the module docstring). -/
def cands (st : State) : Nat :=
  force (Nat.xor FULL (Nat.lor st.F (Nat.lor st.G (Nat.sub (Nat.shiftLeft 1 st.lo) 1)))) fun base =>
  cond (bitB base st.lo && !okRep st) (Nat.xor base (Nat.shiftLeft 1 st.lo)) base

/-! ## The enumeration -/

/-- `loop f fuel cand d` runs `f x` for the set bits `x` of `cand`, threading `d`. The bit taken
next is a guess (`lowIdx`); taking a guess that is not a bit of `cand` only adds work, and the
loop fails if `fuel` runs out. -/
noncomputable def loop {α : Type} (f : Nat → α → Option α) (fuel : Nat) : Nat → α → Option α :=
  Nat.rec (motive := fun _ => Nat → α → Option α)
    (fun cand d => cond (Nat.beq cand 0) (some d) none)
    (fun _ ih cand d => cond (Nat.beq cand 0) (some d) <|
      force (lowIdx cand) fun x => (f x d).bind (ih (Nat.xor cand (Nat.shiftLeft 1 x))))
    fuel

/-- `dfs mid leaf k n st d` visits the extensions of the prefix by up to `n` codes allowed by
`cands`, threading `d`: `leaf` at the extensions by `n` codes, and `mid` at the extensions by
`n - k - 1` codes. -/
noncomputable def dfs {α : Type} (mid leaf : State → α → Option α) (k n : Nat) :
    State → α → Option α :=
  Nat.rec (motive := fun _ => State → α → Option α) leaf
    (fun m ih st d => cond (Nat.beq m k)
      ((mid st d).bind (loop (fun x => ih (step st x)) 64 (cands st)))
      (loop (fun x => ih (step st x)) 64 (cands st) d))
    n

/-! ## The tests at the sequences of length fourteen and eighteen -/

/-- The code sum is `0` or a sum of at most three entries. -/
def long (st : State) : Bool := bitB (Nat.lor st.F 1) (negc st.s)

/-- The three base-4 digits of a code, in separate six-bit fields. -/
def val (c : Nat) : Nat :=
  Nat.add (Nat.land c 3) (Nat.add (Nat.shiftLeft (Nat.land (Nat.shiftRight c 2) 3) 6)
    (Nat.shiftLeft (Nat.shiftRight c 4) 12))

/-- `vec q n = ∑_{i < n} val (code i) * 2 ^ (24 i)`, where code `i` is the code at bits `6 i` of
`q`; for a packed sequence of length `N`, the code at position `j` gets the slot `N - 1 - j`. -/
noncomputable def vec (q n : Nat) : Nat :=
  Nat.rec (motive := fun _ => Nat) 0
    (fun i acc => Nat.add acc (Nat.shiftLeft (val (Nat.land (Nat.shiftRight q (Nat.mul 6 i)) 63))
      (Nat.mul 24 i))) n

/-- The 64 spreads `∑_{j < 6, j ∈ m} 2 ^ (24 j)` of six-bit masks `m`, 144 bits each. -/
def T24 : Nat := 

/-- The 64 spreads `∑_{k < 6, k ∈ m} 2 ^ (432 k)` of six-bit masks `m`, 2592 bits each. -/
def T432 : Nat := 

/-- `spread E = ∑_{j < 18, j ∈ E} 2 ^ (24 j)`: the positions of `E` in 24-bit slots. -/
def spread (E : Nat) : Nat :=
  Nat.add (Nat.land (Nat.shiftRight T24 (Nat.mul 144 (Nat.land E 63))) 22300745198530623141535718272648361505980415)
    (Nat.add (Nat.shiftLeft (Nat.land (Nat.shiftRight T24 (Nat.mul 144 (Nat.land (Nat.shiftRight E 6) 63)))
      22300745198530623141535718272648361505980415) 144)
    (Nat.shiftLeft (Nat.land (Nat.shiftRight T24 (Nat.mul 144 (Nat.land (Nat.shiftRight E 12) 63)))
      22300745198530623141535718272648361505980415) 288))

/-- `spreadWide E = ∑_{k < 18, k ∈ E} 2 ^ (432 k)`. -/
def spreadWide (E : Nat) : Nat :=
  Nat.add (Nat.land (Nat.shiftRight T432 (Nat.mul 2592 (Nat.land E 63))) )
    (Nat.add (Nat.shiftLeft (Nat.land (Nat.shiftRight T432 (Nat.mul 2592 (Nat.land (Nat.shiftRight E 6)
      63))) ) 2592)
    (Nat.shiftLeft (Nat.land (Nat.shiftRight T432 (Nat.mul 2592 (Nat.land (Nat.shiftRight E 12) 63)))
      ) 5184))

/-- The mask `E` is a nonempty set of positions below `N ≤ 18` whose codes sum to zero; `v` is
`vec q N`. The digit sums of the positions in `E` are read off the slot `N - 1` of
`spread E * v`. -/
def zeroMask (N v E : Nat) : Bool :=
  !(Nat.beq E 0) && Nat.beq (Nat.shiftRight E N) 0 &&
    Nat.beq (Nat.land (Nat.shiftRight (Nat.mul (spread E) v) (Nat.mul 24 (Nat.sub N 1))) 12483) 0

/-- `∑ f E` over the certificate entries with coefficient `1` (`b = 0`) or `-1` (`b = 1`). -/
def sumSign (b : Nat) (f : Nat → Nat) (es : List Nat) : Nat :=
  es.foldr (fun e acc => cond (Nat.beq (Nat.land e 1) b) (Nat.add acc (f (Nat.shiftRight e 1))) acc) 0

/-- The certificate `es` is an integral `𝓘_t`-identity (`t = 1, 2`) of the packed sequence `q` of
length `N ≤ 18`. An entry `2 E` (coefficient `1`) or `2 E + 1` (coefficient `-1`) must be a zero
set `E`; the coefficients sum to one; and the moments of degree `t` vanish: for `t = 1`, the sums of
`spread E` with the two signs agree (position by position, at most `2 ^ 24` entries), and for
`t = 2` the sums of `spread E * spreadWide E`, which has a slot for every pair of positions. -/
noncomputable def checkEntries (N t q : Nat) (es : List Nat) : Bool :=
  Nat.ble N 18 && Nat.ble (List.length es) 16777215 &&
    es.all (fun e => zeroMask N (vec q N) (Nat.shiftRight e 1)) &&
    Nat.beq (sumSign 0 (fun _ => 1) es) (Nat.succ (sumSign 1 (fun _ => 1) es)) &&
    cond (Nat.beq t 1) (Nat.beq (sumSign 0 spread es) (sumSign 1 spread es))
      (Nat.beq t 2 &&
        Nat.beq (sumSign 0 (fun E => Nat.mul (spread E) (spreadWide E)) es)
          (sumSign 1 (fun E => Nat.mul (spread E) (spreadWide E)) es))

/-- The data is a stream of 20-bit words: a certificate is its number of entries followed by the
entries. `readWords k d` reads `k` words. -/
noncomputable def readWords (k : Nat) : Nat → List Nat × Nat :=
  Nat.rec (motive := fun _ => Nat → List Nat × Nat) (fun d => ([], d))
    (fun _ ih d => (Nat.land d 1048575 :: (ih (Nat.shiftRight d 20)).1,
      (ih (Nat.shiftRight d 20)).2)) k

/-- Read a certificate from `d` and check it. -/
noncomputable def cert (N t q d : Nat) : Option Nat :=
  cond (checkEntries N t q (readWords (Nat.land d 1048575) (Nat.shiftRight d 20)).1)
    (some (readWords (Nat.land d 1048575) (Nat.shiftRight d 20)).2) none

/-- The test at a sequence of length `N`. -/
noncomputable def leaf (N t : Nat) (st : State) (d : Nat) : Option Nat :=
  cond (long st) (some d) (cert N t st.q d)

/-! ## Splitting the enumeration -/

/-- A prefix of length `k ≤ 14` is named by the token `16 * q + k`, with `q` its packed entries. -/
def token (st : State) (k : Nat) : Nat := Nat.add (Nat.mul 16 st.q) k

/-- The `k` codes packed in `p`, the last one lowest. -/
noncomputable def codesOf (k : Nat) : Nat → List Nat :=
  Nat.rec (motive := fun _ => Nat → List Nat) (fun _ => [])
    (fun _ ih p => ih (Nat.shiftRight p 6) ++ [Nat.land p 63]) k

/-- The prefix named by a token. -/
noncomputable def prefixOf (t : Nat) : List Nat := codesOf (Nat.land t 15) (Nat.shiftRight t 4)

/-- The enumeration down to the chunk roots. The list `ts` says, for every node in the order of the
enumeration, either `0` (descend to the children) or the token of the node (a chunk root, whose
subtree is checked by `chunkRun`). A node of depth `14 - n` may be a chunk root, and only nodes of
depth below fourteen are descended. -/
noncomputable def topDfs (n : Nat) : State → List Nat → Option (List Nat) :=
  Nat.rec (motive := fun _ => State → List Nat → Option (List Nat))
    (fun st ts => match ts with
      | [] => none
      | t :: ts => cond (Nat.beq t (token st 14)) (some ts) none)
    (fun m ih st ts => match ts with
      | [] => none
      | t :: ts => cond (Nat.beq t 0) (loop (fun x => ih (step st x)) 64 (cands st) ts)
          (cond (Nat.beq t (token st (Nat.sub 13 m))) (some ts) none))
    n

/-- The tests of Lemma 5.3 below the chunk roots `ts`: `leaf 14 1` at depth fourteen and
`leaf 18 2` at depth eighteen, threading the data `d`. -/
noncomputable def chunkRun (ts : List Nat) (d : Nat) : Option Nat :=
  ts.foldl (fun acc t => acc.bind (dfs (leaf 14 1) (leaf 18 2) 3 (Nat.sub 18 (Nat.land t 15))
    ((prefixOf t).foldl step root))) (some d)

end DavenportCompute.Search
