/-!
# Lemma 5.3: the chunks

The 512 chunks with their data, the chunk roots they cover, and the fact that these are the
chunk roots listed by `topStream`, in order.
-/

@[expose] public section

namespace DavenportCompute.Checks

open DavenportCompute.Search

/-- Chunks 000 to 031. -/
def chunks0 : List (List Nat × Nat) :=
  [(roots000, data000), (roots001, data001), (roots002, data002), (roots003, data003), (roots004, data004), (roots005, data005), (roots006, data006), (roots007, data007), (roots008, data008), (roots009, data009), (roots010, data010), (roots011, data011), (roots012, data012), (roots013, data013), (roots014, data014), (roots015, data015), (roots016, data016), (roots017, data017), (roots018, data018), (roots019, data019), (roots020, data020), (roots021, data021), (roots022, data022), (roots023, data023), (roots024, data024), (roots025, data025), (roots026, data026), (roots027, data027), (roots028, data028), (roots029, data029), (roots030, data030), (roots031, data031)]

